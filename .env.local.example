# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: only needed for server-side admin operations (do NOT expose to client)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
