# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: only needed for server-side admin operations (do NOT expose to client)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Web Push. Run `npm run push:keys` once, then keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Protects /api/push/send-due. Configure a scheduler to call it once per hour.
CRON_SECRET=
